{
  "expo": {
    "name": "Presensia",
    "slug": "presensia-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presensia",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/823e20f7-f1be-4952-83d3-8c7b5ca89e33"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.go.bantenprov.presensia"
    },
    "android": {
      "package": "id.go.bantenprov.presensia",
      "adaptiveIcon": {
        "backgroundColor": "#B85C42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Presensia membutuhkan akses kamera untuk foto selfie presensi."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Presensia membutuhkan akses lokasi saat presensi untuk validasi radius kantor."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "823e20f7-f1be-4952-83d3-8c7b5ca89e33"
      }
    },
    "owner": "nafi-bussinesss-team"
  }
}
